{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vsc",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "GameRoom"] }
  ],
  "observability": { "enabled": true }
}
